<?xml version="1.0" encoding="utf-8"?>
<!-- Solace is local-first: never copy app data into cloud backups or
     device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
